[user]
    name = {{ .identities.name }}
{{- $id := index .identities .profile }}
    email = {{ $id.email }}
    signingkey = {{ $id.ssh_key }}

[core]
    editor = nvim
    pager = delta
    autocrlf = input

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = {{ .chezmoi.homeDir }}/.ssh/allowedSigners

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    hyperlinks = true

[merge]
    tool = meld
    conflictstyle = diff3

[mergetool "meld"]
    cmd = meld "$LOCAL" "$BASE" "$REMOTE" --output "$MERGED"
    trustExitCode = false

[diff]
    colorMoved = default
    tool = delta

[alias]
    # --- Worktree Management ---
    wt-add = !git worktree add -b $1 ../$1
    wt-ls = worktree list
    wt-rm = !git worktree remove

    # --- Tooling ---
    nd = difftool -t nvimdiff -y
    md = difftool -t meld -y
    lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
    pr = !gh pr create -w
    unstage = restore --staged

[push]
    autoSetupRemote = true
    followTags = true
[pull]
{{- if eq .profile "work" }}
    # Work repos don't allow rebasing by default; use `git pull --rebase` when it's safe.
    ff = only
{{- else }}
    rebase = true
{{- end }}

[rebase]
    updateRefs = true

[init]
    defaultBranch = main
