{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@simonwjackson/opencode-direnv"],
  "instructions": ["AGENT.md", "AGENTS.md", "GEMINI.md"],
  "model": "openrouter/google/gemini-3-flash-preview",
  "provider": {
    "openrouter": {
      "models": {}
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  },
  "agent": {
    "chat": {
      "path": "agents/chat.md"
    },
    "map": {
      "path": "agents/codebase-mapper.md"
    },
    "plan": {
      "path": "agents/architect.md"
    },
    "slice": {
      "path": "agents/slice-orchestrator.md"
    },
    "build": {
      "path": "agents/builder.md"
    },
    "review": {
      "path": "agents/pr-orchestrator.md"
    }
  },
  "default_agent": "chat"
}
