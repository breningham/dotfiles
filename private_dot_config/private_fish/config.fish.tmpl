# -- Add Custom Script directory to path
fish_add_path {{ .chezmoi.homeDir }}/.local/bin

# --- OS-Independent Path & Shell Setup ---
set -g fish_greeting  # no "Welcome to fish" banner
set -gx EDITOR "zed --wait"
set -gx VISUAL "zed --wait"

{{- if eq .chezmoi.os "linux" }}
# --- Bitwarden SSH Agent Handling ---
set -gx SSH_AUTH_SOCK "{{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock"
{{- else if eq .chezmoi.os "darwin" }}
set -gx SSH_AUTH_SOCK "{{ .chezmoi.homeDir }}/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock"
{{- end }}

# --- Git & Workflow Aliases ---
alias lg='lazygit'
alias g='git'

# --- OS-Specific Aliases & Tooling ---
{{- if eq .chezmoi.os "linux" }}
# CachyOS / Arch Specifics
alias update='sudo pacman -Syu'
# Ensure Meld is in the path for 3-way merges
{{- else if eq .chezmoi.os "darwin" }}
# macOS / Homebrew Specifics
alias update='topgrade'
# Ensure Homebrew binaries are prioritized
fish_add_path /opt/homebrew/bin
{{- end }}

if command -v mise &> /dev/null
   mise activate fish | source
end

function bw-unlock
    set -gx BW_SESSION (bw unlock --raw)
    echo "Bitwarden unlocked for this session."
end

if status is-interactive
    command -q atuin; and atuin init fish | source
    command -q starship; and starship init fish | source
    # `_carapace` is the init script; `carapace fish` would print fish's own zsh completer.
    command -q carapace; and carapace _carapace fish | source
    command -q aws-sso; and aws-sso setup completions --source --shell fish | source
end
